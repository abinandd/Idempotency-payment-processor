# Database
DATABASE_URL=jdbc:h2:mem:payment_db;MODE=PostgreSQL;DB_CLOSE_DELAY=-1;DB_CLOSE_ON_EXIT=FALSE
DATABASE_USERNAME=sa
DATABASE_PASSWORD=

# Redis (Upstash)
REDIS_URL=rediss://default:YOUR_UPSTASH_TOKEN@YOUR_INSTANCE.upstash.io:6379

# App
IDEMPOTENCY_TTL=86400
BANK_MODE=SUCCESS
BANK_TIMEOUT=5000
RECONCILIATION_INTERVAL=30000
